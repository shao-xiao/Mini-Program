<view class="page">
  <view wx:if="{{pageState === 'login-required'}}" class="card section">
    <view class="empty-title">登录后查看账单</view>
    <view class="empty-desc">{{errorMessage}}</view>
    <button class="button-primary bind-button" bindtap="goProfile">去登录</button>
  </view>

  <view wx:elif="{{pageState === 'unauthorized'}}" class="card section">
    <view class="empty-title">当前账号暂无账单权限</view>
    <view class="empty-desc">{{errorMessage}}</view>
    <button class="button-primary bind-button" bindtap="goProfile">查看账号</button>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="card section">
    <view class="empty-title">账单加载失败</view>
    <view class="empty-desc">{{errorMessage}}</view>
    <button class="button-primary bind-button" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{pageState === 'loading'}}" class="card muted">正在加载账单...</view>

  <block wx:else>
    <view class="account-overview section">
      <view class="overview-head">
        <view>
          <view class="overview-tenant">{{tenantName || '当前租户'}}</view>
          <view class="overview-caption">我的账单</view>
        </view>
        <view class="overview-count">共 {{summary.totalCount}} 笔</view>
      </view>

      <view class="overview-balance">
        <view class="balance-main">
          <view class="balance-label">当前待缴</view>
          <view class="balance-value"><text class="currency">¥</text>{{summary.unpaidAmount}}</view>
          <view class="balance-help">
            {{summary.unpaidCount > 0 ? summary.unpaidCount + ' 笔账单待处理' : '当前没有待缴账单'}}
          </view>
        </view>
        <view class="balance-settled">
          <view class="settled-label">已结清</view>
          <view class="settled-value">¥{{summary.paidAmount}}</view>
          <view class="settled-count">{{summary.paidCount}} 笔</view>
        </view>
      </view>

      <view wx:if="{{summary.overdueCount > 0}}" class="overview-notice overdue" data-value="OVERDUE" bindtap="changeStatus">
        <view class="notice-dot"></view>
        <view class="notice-text">其中 {{summary.overdueCount}} 笔已超过到期日，待缴 ¥{{summary.overdueAmount}}</view>
        <view class="notice-link">查看</view>
      </view>
      <view wx:else class="overview-notice normal">
        <view class="notice-dot"></view>
        <view class="notice-text">{{summary.unpaidCount > 0 ? '待缴账单均在正常账期内' : '账单已妥善结清，感谢您的配合'}}</view>
      </view>

      <view class="overview-total">累计已发布账单 ¥{{summary.totalAmount}}</view>
    </view>

    <view class="bill-toolbar section">
      <view class="status-segment">
        <view
          wx:for="{{statusFilters}}"
          wx:key="value"
          class="status-item {{activeStatus === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="changeStatus"
        >
          {{item.label}}
        </view>
      </view>
      <picker
        class="type-picker-wrap"
        mode="selector"
        range="{{typeFilters}}"
        range-key="label"
        value="{{activeTypeIndex}}"
        bindchange="changeType"
      >
        <view class="type-picker">
          <text>{{activeTypeLabel}}</text>
          <text class="picker-arrow">⌄</text>
        </view>
      </picker>
    </view>

    <view wx:if="{{bills.length === 0}}" class="card muted">
      当前筛选条件下暂无账单
    </view>

    <view wx:else class="section bill-list">
      <view wx:for="{{bills}}" wx:key="id" class="bill-card {{item.statusClass}}" data-id="{{item.id}}" bindtap="openDetail">
        <view class="bill-head">
          <view class="bill-main">
            <view class="bill-category">{{item.categoryLabel}}</view>
            <view class="bill-title">{{item.displayTitle}}</view>
            <view wx:if="{{item.hasPeriod}}" class="bill-period">{{item.periodText}}</view>
          </view>
          <view class="bill-status {{item.statusClass}}">{{item.statusDisplay}}</view>
        </view>

        <view class="bill-amount-row">
          <view>
            <view class="bill-amount-label">{{item.primaryAmountLabel}}</view>
            <view class="bill-money">¥{{item.primaryAmountText}}</view>
          </view>
          <view class="bill-number">{{item.billNumber}}</view>
        </view>

        <view class="bill-facts">
          <view class="bill-fact">
            <view class="fact-label">账单金额</view>
            <view class="fact-value">¥{{item.amountText}}</view>
          </view>
          <view class="bill-fact">
            <view class="fact-label">{{item.status === 'PAID' ? '确认收款' : '到期日'}}</view>
            <view class="fact-value">{{item.status === 'PAID' && item.paidAtText ? item.paidAtText : item.dueDateText}}</view>
          </view>
          <view class="bill-fact">
            <view class="fact-label">发票</view>
            <view class="fact-value invoice-state">{{item.invoiceStatusText}}</view>
          </view>
        </view>

        <view wx:if="{{item.hasEnergyDetail}}" class="energy-detail">
          <view class="energy-title">用量明细</view>
          <view class="energy-grid">
            <view wx:if="{{item.hasPreviousReading}}" class="energy-item">上期读数：{{item.previousReadingText}}</view>
            <view wx:if="{{item.hasCurrentReading}}" class="energy-item">本期读数：{{item.currentReadingText}}</view>
            <view wx:if="{{item.hasUsage}}" class="energy-item">本期用量：{{item.usageText}}</view>
            <view wx:if="{{item.hasUnitPrice}}" class="energy-item">单价：¥{{item.unitPriceText}}</view>
            <view wx:if="{{item.hasMeterReadingDate}}" class="energy-item wide">抄表日期：{{item.meterReadingDateText}}</view>
          </view>
        </view>

        <view wx:if="{{item.remark}}" class="bill-remark">{{item.remark}}</view>

        <view class="bill-footer">
          <view class="detail-entry">查看费用明细 <text>›</text></view>
          <view class="bill-actions">
            <button
              wx:if="{{item.hasInvoiceFile}}"
              class="invoice-button"
              size="mini"
              data-id="{{item.id}}"
              data-url="{{item.invoiceDownloadUrl}}"
              data-filename="{{item.invoiceFileName}}"
              loading="{{downloadingBillId === item.id}}"
              disabled="{{downloadingBillId === item.id}}"
              catchtap="downloadInvoice"
            >
              查看发票
            </button>
            <button
              wx:if="{{item.status !== 'PAID' && item.status !== 'CANCELLED'}}"
              class="pay-button"
              size="mini"
              data-number="{{item.billNumber}}"
              data-title="{{item.displayTitle}}"
              data-amount="{{item.unpaidAmountText}}"
          catchtap="showPaymentGuide"
            >
              缴费方式
            </button>
          </view>
        </view>
      </view>
    </view>
    <view class="more">{{loadingMore ? '加载中…' : (noMore && total > 0 ? '没有更多数据' : '上拉加载更多')}}</view>
  </block>
</view>
