.section-title {
  margin: 4rpx 0 16rpx;
  color: #1f1b1b;
  font-size: 30rpx;
  font-weight: 700;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f5f6f8;
  color: #1f1b1b;
  font-size: 26rpx;
}

.input {
  height: 72rpx;
  line-height: 72rpx;
}

.picker-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.picker-field {
  flex: 1;
}

.picker-input {
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f5f6f8;
  color: #1f1b1b;
  font-size: 26rpx;
  line-height: 72rpx;
}

.picker-placeholder {
  color: #a8abb2;
}

.textarea {
  min-height: 150rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 38rpx;
}

.input-placeholder {
  color: #a8abb2;
  font-size: 26rpx;
}

.submit-button,
.bind-button {
  margin-top: 24rpx;
}

.visitor-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 27, 27, 0.06);
}

.reservation-history-card {
  margin-bottom: 14rpx;
}

.reservation-history-section {
  margin-bottom: 10rpx;
}

.history-title {
  margin-bottom: 8rpx;
}

.history-scope-tip {
  margin-bottom: 16rpx;
  color: #73767a;
  font-size: 22rpx;
  line-height: 1.5;
}

.history-state {
  padding: 22rpx 0;
  color: #909399;
  font-size: 24rpx;
  text-align: center;
}

.history-error {
  color: #b42318;
}

.history-retry {
  display: inline-block;
  margin: 12rpx 0 0;
  border: 1rpx solid #dcdfe6;
  background: #ffffff;
  color: #303133;
}

.compact-history-card {
  margin-bottom: 14rpx;
  padding: 20rpx;
  border: 1rpx solid #ebeef5;
  box-shadow: none;
}

.compact-history-card:last-child {
  margin-bottom: 0;
}

.visitor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.visitor-title {
  color: #1f1b1b;
  font-size: 32rpx;
  font-weight: 700;
}

.visitor-phone,
.visitor-meta {
  margin-top: 8rpx;
  color: #73767a;
  font-size: 24rpx;
}

.visitor-desc {
  margin-top: 14rpx;
  color: #303133;
  font-size: 26rpx;
  line-height: 1.6;
}

.visitor-remark {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: #f5f6f8;
  color: #606266;
  font-size: 24rpx;
  line-height: 1.6;
}

.status {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status.registered {
  background: #fdecea;
  color: #d93025;
}

.status.entered {
  background: #e8f5e9;
  color: #2e7d32;
}

.status.left,
.status.cancelled {
  background: #ebeef5;
  color: #909399;
}

.visitor-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.review-tip {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.pending-tip {
  background: #fff7e6;
  color: #ad6800;
}

.approved-tip {
  background: #e8f5e9;
  color: #237b32;
}

.rejected-tip {
  background: #fff1f0;
  color: #b42318;
}

.qr-button {
  height: 72rpx;
  margin: 20rpx 0 0;
  border: 0;
  border-radius: 10rpx;
  background: #ed2f2a;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.qr-button::after,
.qr-close-button::after {
  border: 0;
}

.qr-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background: rgba(0, 0, 0, 0.52);
}

.qr-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 640rpx;
  padding: 28rpx 30rpx 30rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.qr-dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ebeef5;
}

.qr-dialog-title {
  color: #1f1b1b;
  font-size: 32rpx;
  font-weight: 700;
}

.qr-close {
  padding: 0 4rpx;
  color: #73767a;
  font-size: 42rpx;
  line-height: 1;
}

.qr-code-text {
  margin-top: 28rpx;
  color: #303133;
  font-size: 30rpx;
  text-align: center;
}

.qr-instruction {
  margin-top: 16rpx;
  color: #1677ff;
  font-size: 24rpx;
  text-align: center;
}

.qr-image-wrap {
  display: grid;
  width: 320rpx;
  height: 320rpx;
  margin: 24rpx auto 0;
  place-items: center;
  background: #ffffff;
}

.qr-image {
  width: 320rpx;
  height: 320rpx;
}

.qr-loading {
  color: #909399;
  font-size: 24rpx;
  text-align: center;
}

.qr-longpress-tip {
  margin-top: 14rpx;
  color: #909399;
  font-size: 22rpx;
  text-align: center;
}

.qr-close-button {
  width: 200rpx;
  height: 68rpx;
  margin: 24rpx auto 0;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  background: #ffffff;
  color: #303133;
  font-size: 26rpx;
  line-height: 66rpx;
}

.cancel-button {
  margin: 0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #d93025;
  border: 1rpx solid #d93025;
  font-size: 24rpx;
}

.empty-title {
  color: #1f1b1b;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 12rpx;
  color: #73767a;
  font-size: 26rpx;
  line-height: 1.6;
}

.tenant-visitor-page {
  padding: 16rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.tenant-visitor-page .section {
  margin-bottom: 14rpx;
}

.tenant-visitor-page .card {
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 41, 51, 0.04);
}

.tenant-history-panel {
  overflow: hidden;
}

.tenant-history-heading,
.tenant-form-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.tenant-history-heading {
  padding-bottom: 14rpx;
}

.tenant-history-heading .history-title,
.tenant-form-title {
  margin: 0;
  font-size: 28rpx;
  line-height: 38rpx;
}

.tenant-history-identity,
.tenant-form-tip {
  max-width: 500rpx;
  margin-top: 3rpx;
  overflow: hidden;
  color: #7b8794;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tenant-history-count,
.tenant-required-tip {
  flex: none;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #f3f5f7;
  color: #52606d;
  font-size: 20rpx;
  line-height: 28rpx;
}

.tenant-required-tip text {
  color: #e4312b;
}

.tenant-history-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 13rpx 16rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  text-align: left;
}

.tenant-empty-title {
  flex: none;
  color: #52606d;
  font-size: 23rpx;
  font-weight: 600;
}

.tenant-empty-desc {
  overflow: hidden;
  color: #98a2b3;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tenant-history-item {
  margin: 0;
  padding: 16rpx 0;
  border-top: 1rpx solid #edf0f3;
  border-radius: 0;
  box-shadow: none;
}

.tenant-history-item:last-of-type {
  padding-bottom: 0;
}

.tenant-visitor-main {
  min-width: 0;
}

.tenant-visitor-name-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
  gap: 10rpx;
}

.tenant-history-item .visitor-title {
  overflow: hidden;
  font-size: 27rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tenant-history-item .visitor-phone,
.tenant-history-item .visitor-meta {
  margin-top: 0;
  color: #7b8794;
  font-size: 21rpx;
  line-height: 30rpx;
}

.tenant-history-item .visitor-phone {
  flex: none;
}

.tenant-status-column {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  gap: 5rpx;
}

.tenant-history-item .status {
  padding: 4rpx 10rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.tenant-detail-hint {
  color: #98a2b3;
  font-size: 19rpx;
  line-height: 26rpx;
}

.tenant-visitor-desc {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: #334e68;
  font-size: 22rpx;
  line-height: 30rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.tenant-visitor-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 14rpx;
  margin-top: 5rpx;
  color: #7b8794;
  font-size: 20rpx;
  line-height: 28rpx;
}

.tenant-review-tip {
  display: inline-block;
  margin-top: 7rpx;
  padding: 5rpx 9rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.tenant-visitor-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 9rpx;
}

.tenant-action-button {
  box-sizing: border-box;
  width: auto;
  min-width: 140rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 22rpx;
  line-height: 54rpx;
}

.tenant-action-button::after {
  border: 0;
}

.tenant-history-more {
  padding: 13rpx 0 0;
  border-top: 1rpx solid #edf0f3;
  font-size: 21rpx;
}

.tenant-visitor-form {
  margin-bottom: 0;
}

.tenant-form-heading {
  margin-bottom: 14rpx;
}

.tenant-submit-button {
  height: 68rpx;
  margin-top: 16rpx;
  border-radius: 10rpx;
  font-size: 25rpx;
  line-height: 68rpx;
}

.tenant-submit-button::after {
  border: 0;
}

.public-visitor-intro {
  border: 1rpx solid #ffd7d5;
  background: #fff8f7;
}

.public-visitor-page {
  padding: 16rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.public-visitor-page .public-visitor-intro {
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(228, 49, 43, 0.05);
}

.public-visitor-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.public-visitor-heading .title {
  font-size: 32rpx;
}

.public-visitor-badge {
  flex: none;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #ffe8e6;
  color: #d92d27;
  font-size: 20rpx;
  line-height: 1.3;
}

.public-visitor-page .empty-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.public-visitor-form {
  margin-bottom: 0;
  padding: 18rpx 20rpx 20rpx;
  border-radius: 16rpx;
}

.public-section-title {
  margin: 0 0 10rpx;
  font-size: 28rpx;
}

.public-field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.public-field-grid .public-input {
  min-width: 0;
  height: 68rpx;
  margin-top: 0;
  padding: 0 14rpx;
  border: 1rpx solid #edf0f3;
  border-radius: 10rpx;
  background: #f7f8fa;
  font-size: 24rpx;
  line-height: 68rpx;
}

.public-visitor-page .input-placeholder {
  font-size: 23rpx;
}

.public-picker-grid {
  gap: 12rpx;
  margin-top: 12rpx;
}

.public-picker-grid .picker-field {
  min-width: 0;
}

.public-visitor-page .textarea {
  margin-top: 12rpx;
  padding: 13rpx 14rpx;
  border: 1rpx solid #edf0f3;
  border-radius: 10rpx;
  background: #f7f8fa;
  font-size: 24rpx;
  line-height: 32rpx;
}

.public-reason-textarea {
  height: 100rpx;
  min-height: 100rpx;
}

.public-remark-textarea {
  height: 72rpx;
  min-height: 72rpx;
}

.public-submit-row {
  display: block;
  margin-top: 14rpx;
}

.public-privacy-tip {
  margin-top: 0;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  background: #f5f6f8;
  color: #73767a;
  font-size: 19rpx;
  line-height: 1.35;
}

.public-submit-button {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 68rpx;
  margin: 12rpx 0 0;
  padding: 0 12rpx;
  overflow: hidden;
  font-size: 24rpx;
  line-height: 68rpx;
  white-space: nowrap;
}

.public-submit-button::after {
  border: 0;
}
