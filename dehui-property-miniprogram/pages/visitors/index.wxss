page {
  --dhic-page-action-primary: var(--dhic-success);
  --dhic-page-action-soft: var(--dhic-success-soft);
  --dhic-page-action-rgb: var(--dhic-success-rgb);
}

.section-title {
  margin: 4rpx 0 16rpx;
  color: var(--dhic-text-primary);
  font-size: 30rpx;
  font-weight: var(--dhic-weight-data);
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: var(--dhic-page-bg);
  color: var(--dhic-text-primary);
  font-size: 26rpx;
}

.input {
  height: 72rpx;
  line-height: 72rpx;
}

.picker-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.picker-field {
  flex: 1;
}

.picker-input {
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: var(--dhic-page-bg);
  color: var(--dhic-text-primary);
  font-size: 26rpx;
  line-height: 72rpx;
}

.picker-placeholder {
  color: var(--dhic-text-tertiary);
}

.textarea {
  min-height: 150rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 38rpx;
}

.input-placeholder {
  color: var(--dhic-text-tertiary);
  font-size: 26rpx;
}

.submit-button,
.bind-button {
  margin-top: 24rpx;
}

.visitor-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: var(--dhic-surface);
  box-shadow: 0 8rpx 24rpx rgba(var(--dhic-ink-rgb), 0.06);
}

.reservation-history-card {
  margin-bottom: 14rpx;
}

.reservation-history-section {
  margin-bottom: 10rpx;
}

.history-title {
  margin-bottom: 8rpx;
}

.history-scope-tip {
  margin-bottom: 16rpx;
  color: var(--dhic-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.history-state {
  padding: 22rpx 0;
  color: var(--dhic-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.history-error {
  color: var(--dhic-danger);
}

.history-retry {
  display: inline-block;
  margin: 12rpx 0 0;
  border: 1rpx solid var(--dhic-border);
  background: var(--dhic-surface);
  color: var(--dhic-text-primary);
}

.compact-history-card {
  margin-bottom: 14rpx;
  padding: 20rpx;
  border: 1rpx solid var(--dhic-border-light);
  box-shadow: none;
}

.compact-history-card:last-child {
  margin-bottom: 0;
}

.visitor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.visitor-title {
  color: var(--dhic-text-primary);
  font-size: 32rpx;
  font-weight: var(--dhic-weight-data);
}

.visitor-phone,
.visitor-meta {
  margin-top: 8rpx;
  color: var(--dhic-text-secondary);
  font-size: 24rpx;
}

.visitor-desc {
  margin-top: 14rpx;
  color: var(--dhic-text-primary);
  font-size: 26rpx;
  line-height: 1.6;
}

.visitor-remark {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  background: var(--dhic-page-bg);
  color: var(--dhic-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.status {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: var(--dhic-radius-pill);
  font-size: 22rpx;
}

.status.registered {
  background: var(--dhic-warning-soft);
  color: var(--dhic-warning);
}

.status.entered {
  background: var(--dhic-success-soft);
  color: var(--dhic-success);
}

.status.left,
.status.cancelled {
  background: var(--dhic-surface-pressed);
  color: var(--dhic-text-tertiary);
}

.visitor-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.review-tip {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.pending-tip {
  background: var(--dhic-warning-soft);
  color: var(--dhic-orange);
}

.approved-tip {
  background: var(--dhic-success-soft);
  color: var(--dhic-success);
}

.rejected-tip {
  background: var(--dhic-danger-soft);
  color: var(--dhic-danger);
}

.qr-button {
  height: 72rpx;
  margin: 20rpx 0 0;
  border: 0;
  border-radius: 10rpx;
  background: var(--dhic-action-primary);
  color: var(--dhic-text-inverse);
  font-size: 26rpx;
  line-height: 72rpx;
}

.qr-button::after,
.qr-close-button::after {
  border: 0;
}

.qr-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background: rgba(var(--dhic-ink-rgb), 0.52);
}

.qr-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 640rpx;
  padding: 28rpx 30rpx 30rpx;
  border-radius: 14rpx;
  background: var(--dhic-surface);
}

.qr-dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--dhic-border-light);
}

.qr-dialog-title {
  color: var(--dhic-text-primary);
  font-size: 32rpx;
  font-weight: var(--dhic-weight-data);
}

.qr-close {
  padding: 0 4rpx;
  color: var(--dhic-text-secondary);
  font-size: 42rpx;
  line-height: 1;
}

.qr-code-text {
  margin-top: 28rpx;
  color: var(--dhic-text-primary);
  font-size: 30rpx;
  text-align: center;
}

.qr-instruction {
  margin-top: 16rpx;
  color: var(--dhic-tech-accent);
  font-size: 24rpx;
  text-align: center;
}

.qr-image-wrap {
  display: grid;
  width: 320rpx;
  height: 320rpx;
  margin: 24rpx auto 0;
  place-items: center;
  background: var(--dhic-surface);
}

.qr-image {
  width: 320rpx;
  height: 320rpx;
}

.qr-loading {
  color: var(--dhic-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.qr-longpress-tip {
  margin-top: 14rpx;
  color: var(--dhic-text-tertiary);
  font-size: 22rpx;
  text-align: center;
}

.qr-close-button {
  width: 200rpx;
  height: 68rpx;
  margin: 24rpx auto 0;
  border: 1rpx solid var(--dhic-border);
  border-radius: 8rpx;
  background: var(--dhic-surface);
  color: var(--dhic-text-primary);
  font-size: 26rpx;
  line-height: 66rpx;
}

.cancel-button {
  margin: 0;
  border-radius: 8rpx;
  background: var(--dhic-surface);
  color: var(--dhic-danger);
  border: 1rpx solid var(--dhic-danger);
  font-size: 24rpx;
}

.empty-title {
  color: var(--dhic-text-primary);
  font-size: 30rpx;
  font-weight: var(--dhic-weight-data);
}

.empty-desc {
  margin-top: 12rpx;
  color: var(--dhic-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.tenant-visitor-page {
  padding: 16rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.tenant-visitor-page .section {
  margin-bottom: 14rpx;
}

.tenant-visitor-page .card {
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(var(--dhic-ink-rgb), 0.04);
}

.tenant-history-panel {
  overflow: hidden;
}

.tenant-history-heading,
.tenant-form-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.tenant-history-heading {
  padding-bottom: 14rpx;
}

.tenant-history-heading .history-title,
.tenant-form-title {
  margin: 0;
  font-size: 28rpx;
  line-height: 38rpx;
}

.tenant-history-identity,
.tenant-form-tip {
  max-width: 500rpx;
  margin-top: 3rpx;
  overflow: hidden;
  color: var(--dhic-text-secondary);
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tenant-history-count,
.tenant-required-tip {
  flex: none;
  padding: 5rpx 12rpx;
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-surface-muted);
  color: var(--dhic-text-secondary);
  font-size: 20rpx;
  line-height: 28rpx;
}

.tenant-required-tip text {
  color: var(--dhic-danger);
}

.tenant-history-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 13rpx 16rpx;
  border-radius: 10rpx;
  background: var(--dhic-page-bg);
  text-align: left;
}

.tenant-empty-title {
  flex: none;
  color: var(--dhic-text-secondary);
  font-size: 23rpx;
  font-weight: var(--dhic-weight-heading);
}

.tenant-empty-desc {
  overflow: hidden;
  color: var(--dhic-text-tertiary);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tenant-history-item {
  margin: 0;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--dhic-border-light);
  border-radius: 0;
  box-shadow: none;
}

.tenant-history-item:last-of-type {
  padding-bottom: 0;
}

.tenant-visitor-main {
  min-width: 0;
}

.tenant-visitor-name-row {
  display: flex;
  align-items: baseline;
  min-width: 0;
  gap: 10rpx;
}

.tenant-history-item .visitor-title {
  overflow: hidden;
  font-size: 27rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tenant-history-item .visitor-phone,
.tenant-history-item .visitor-meta {
  margin-top: 0;
  color: var(--dhic-text-secondary);
  font-size: 21rpx;
  line-height: 30rpx;
}

.tenant-history-item .visitor-phone {
  flex: none;
}

.tenant-status-column {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  gap: 5rpx;
}

.tenant-history-item .status {
  padding: 4rpx 10rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.tenant-detail-hint {
  color: var(--dhic-text-tertiary);
  font-size: 19rpx;
  line-height: 26rpx;
}

.tenant-visitor-desc {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--dhic-tech-primary);
  font-size: 22rpx;
  line-height: 30rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.tenant-visitor-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 14rpx;
  margin-top: 5rpx;
  color: var(--dhic-text-secondary);
  font-size: 20rpx;
  line-height: 28rpx;
}

.tenant-review-tip {
  display: inline-block;
  margin-top: 7rpx;
  padding: 5rpx 9rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.tenant-visitor-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 9rpx;
}

.tenant-action-button {
  box-sizing: border-box;
  width: auto;
  min-width: 140rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  font-size: 22rpx;
  line-height: 54rpx;
}

.tenant-action-button::after {
  border: 0;
}

.tenant-history-more {
  padding: 13rpx 0 0;
  border-top: 1rpx solid var(--dhic-border-light);
  font-size: 21rpx;
}

.tenant-visitor-form {
  margin-bottom: 0;
}

.tenant-form-heading {
  margin-bottom: 14rpx;
}

.tenant-submit-button {
  height: 68rpx;
  margin-top: 16rpx;
  border-radius: 10rpx;
  font-size: 25rpx;
  line-height: 68rpx;
}

.tenant-submit-button::after {
  border: 0;
}

.public-visitor-intro {
  border: 1rpx solid var(--dhic-border);
  background: var(--dhic-tech-soft);
}

.public-visitor-page {
  padding: 16rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.public-visitor-page .public-visitor-intro {
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(var(--dhic-brand-rgb), 0.05);
}

.public-visitor-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.public-visitor-heading .title {
  font-size: 32rpx;
}

.public-visitor-badge {
  flex: none;
  padding: 5rpx 12rpx;
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-info-soft);
  color: var(--dhic-info);
  font-size: 20rpx;
  line-height: 1.3;
}

.public-visitor-page .empty-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.public-visitor-form {
  margin-bottom: 0;
  padding: 18rpx 20rpx 20rpx;
  border-radius: 16rpx;
}

.public-section-title {
  margin: 0 0 10rpx;
  font-size: 28rpx;
}

.public-field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.public-field-grid .public-input {
  min-width: 0;
  height: 68rpx;
  margin-top: 0;
  padding: 0 14rpx;
  border: 1rpx solid var(--dhic-border-light);
  border-radius: 10rpx;
  background: var(--dhic-page-bg);
  font-size: 24rpx;
  line-height: 68rpx;
}

.public-visitor-page .input-placeholder {
  font-size: 23rpx;
}

.public-picker-grid {
  gap: 12rpx;
  margin-top: 12rpx;
}

.public-picker-grid .picker-field {
  min-width: 0;
}

.public-visitor-page .textarea {
  margin-top: 12rpx;
  padding: 13rpx 14rpx;
  border: 1rpx solid var(--dhic-border-light);
  border-radius: 10rpx;
  background: var(--dhic-page-bg);
  font-size: 24rpx;
  line-height: 32rpx;
}

.public-reason-textarea {
  height: 100rpx;
  min-height: 100rpx;
}

.public-remark-textarea {
  height: 72rpx;
  min-height: 72rpx;
}

.public-submit-row {
  display: block;
  margin-top: 14rpx;
}

.public-privacy-tip {
  margin-top: 0;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  background: var(--dhic-page-bg);
  color: var(--dhic-text-secondary);
  font-size: 19rpx;
  line-height: 1.35;
}

.public-submit-button {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 68rpx;
  margin: 12rpx 0 0;
  padding: 0 12rpx;
  overflow: hidden;
  font-size: 24rpx;
  line-height: 68rpx;
  white-space: nowrap;
}

.public-submit-button::after {
  border: 0;
}

/* 访客数据服务：提交使用通行绿色，信息源与流程使用深蓝/青色科技语义。 */
.visitor-data-page {
  background:
    linear-gradient(180deg, rgba(var(--dhic-accent-rgb), 0.055) 0, rgba(var(--dhic-white-rgb), 0) 330rpx),
    var(--dhic-page-bg);
}

.visitor-source-section {
  margin-bottom: 16rpx;
}

.visitor-data-page .card {
  border: 1rpx solid rgba(var(--dhic-accent-rgb), 0.07);
  box-shadow: 0 6rpx 18rpx rgba(var(--dhic-accent-rgb), 0.05);
}

.history-source-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
  color: var(--dhic-text-secondary);
  font-size: 19rpx;
  font-weight: var(--dhic-weight-heading);
  line-height: 27rpx;
}

.history-source-dot {
  flex: none;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: var(--dhic-tech-accent);
  box-shadow: 0 0 11rpx rgba(var(--dhic-accent-rgb), 0.5);
}

.history-source-count {
  margin-left: auto;
  color: var(--dhic-text-tertiary);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 18rpx;
  font-weight: var(--dhic-weight-heading);
}

.reservation-history-card,
.tenant-history-panel,
.public-visitor-form,
.tenant-visitor-form {
  padding: 20rpx;
  border-radius: 16rpx;
}

.history-title,
.public-section-title,
.tenant-form-title {
  color: var(--dhic-tech-800);
  font-size: 28rpx;
  line-height: 38rpx;
}

.history-scope-tip {
  margin-bottom: 12rpx;
  color: var(--dhic-text-tertiary);
  font-size: 20rpx;
  line-height: 29rpx;
}

.compact-history-card {
  margin-bottom: 10rpx;
  padding: 15rpx 16rpx;
  border-color: var(--dhic-border-light);
  border-radius: 10rpx;
  box-shadow: inset 4rpx 0 var(--dhic-border);
}

.compact-history-card:active {
  border-color: rgba(var(--dhic-accent-rgb), 0.3);
  background: var(--dhic-surface-subtle);
  box-shadow: inset 4rpx 0 var(--dhic-tech-accent);
}

.compact-history-card .visitor-title {
  color: var(--dhic-tech-800);
  font-size: 26rpx;
}

.compact-history-card .visitor-phone,
.compact-history-card .visitor-meta {
  margin-top: 4rpx;
  color: var(--dhic-text-secondary);
  font-size: 20rpx;
}

.compact-history-card .visitor-desc {
  margin-top: 7rpx;
  color: var(--dhic-tech-primary);
  font-size: 22rpx;
  line-height: 31rpx;
}

.public-form-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.form-source-text,
.tenant-section-source {
  color: var(--dhic-text-secondary);
  font-size: 19rpx;
  font-weight: var(--dhic-weight-heading);
  line-height: 27rpx;
}

.form-source-text {
  margin-top: 2rpx;
}

.tenant-section-source {
  display: flex;
  align-items: center;
  gap: 7rpx;
  margin-bottom: 3rpx;
}

.tenant-section-source-dot {
  flex: none;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: var(--dhic-tech-accent);
  box-shadow: 0 0 10rpx rgba(var(--dhic-accent-rgb), 0.45);
}

.visitor-process {
  display: flex;
  align-items: flex-start;
  margin: 14rpx 0 4rpx;
  padding: 12rpx 14rpx 10rpx;
  border: 1rpx solid var(--dhic-border);
  border-radius: 10rpx;
  background:
    linear-gradient(90deg, rgba(var(--dhic-accent-rgb), 0.04) 1rpx, transparent 1rpx),
    var(--dhic-surface-subtle);
  background-size: 32rpx 100%;
}

.visitor-process-item {
  flex: none;
  min-width: 104rpx;
  color: var(--dhic-text-tertiary);
  text-align: center;
}

.visitor-process-index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 29rpx;
  border: 1rpx solid var(--dhic-border);
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-surface);
  color: var(--dhic-text-secondary);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 17rpx;
  line-height: 29rpx;
}

.visitor-process-item.active .visitor-process-index {
  border-color: rgba(var(--dhic-accent-rgb), 0.44);
  background: var(--dhic-tech-primary);
  color: var(--dhic-text-inverse);
  box-shadow: 0 0 14rpx rgba(var(--dhic-accent-rgb), 0.18);
}

.visitor-process-text {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  white-space: nowrap;
}

.visitor-process-item.active .visitor-process-text {
  color: var(--dhic-tech-primary);
  font-weight: var(--dhic-weight-heading);
}

.visitor-process-line {
  flex: 1;
  height: 1rpx;
  min-width: 24rpx;
  margin-top: 15rpx;
  background: linear-gradient(90deg, var(--dhic-border), var(--dhic-border));
}

.tenant-process {
  margin-top: 12rpx;
  margin-bottom: 14rpx;
}

.tenant-history-heading {
  padding-bottom: 11rpx;
}

.tenant-history-count,
.tenant-required-tip,
.public-visitor-badge {
  border: 1rpx solid rgba(var(--dhic-accent-rgb), 0.16);
  background: var(--dhic-surface-muted);
  color: var(--dhic-tech-500);
}

.tenant-history-identity,
.tenant-form-tip {
  color: var(--dhic-text-secondary);
  font-size: 20rpx;
}

.tenant-history-item {
  padding: 13rpx 2rpx;
  border-top-color: var(--dhic-border-light);
}

.tenant-history-item .visitor-title {
  color: var(--dhic-tech-800);
  font-size: 25rpx;
}

.tenant-visitor-desc {
  color: var(--dhic-tech-primary);
  font-size: 21rpx;
}

.tenant-visitor-facts {
  color: var(--dhic-text-secondary);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 18rpx;
}

.tenant-form-heading {
  margin-bottom: 0;
}

.public-field-grid,
.public-picker-grid {
  gap: 10rpx;
  margin-top: 10rpx;
}

.public-field-grid .public-input,
.public-visitor-page .textarea {
  border-color: var(--dhic-border);
  background: var(--dhic-surface-subtle);
}

.public-reason-textarea {
  height: 92rpx;
  min-height: 92rpx;
}

.public-remark-textarea {
  height: 68rpx;
  min-height: 68rpx;
}

.public-privacy-tip {
  border-left: 4rpx solid var(--dhic-border-strong);
  background: var(--dhic-surface-muted);
  color: var(--dhic-text-secondary);
}

.tenant-submit-button,
.public-submit-button {
  color: var(--dhic-text-inverse);
  background: var(--dhic-action-primary);
  box-shadow: var(--dhic-shadow-action);
}

.qr-dialog {
  border: 1rpx solid rgba(var(--dhic-accent-rgb), 0.15);
  box-shadow: 0 24rpx 80rpx rgba(var(--dhic-accent-rgb), 0.22);
}

/* Phase 2: DHIC visitor service visual refinement. */
.visitor-data-page .card {
  border: 0;
  border-radius: var(--dhic-radius-section);
  background: var(--dhic-surface);
  box-shadow: var(--dhic-shadow-card);
}

.reservation-history-card,
.tenant-history-panel,
.public-visitor-form,
.tenant-visitor-form {
  border-radius: var(--dhic-radius-section);
}

.visitor-data-page .reservation-history-card,
.visitor-data-page .tenant-history-panel {
  background: linear-gradient(160deg, var(--dhic-info-soft) 0%, var(--dhic-tech-soft) 100%);
}

.history-title,
.public-section-title,
.tenant-form-title,
.empty-title {
  color: var(--dhic-text-primary);
  font-weight: var(--dhic-weight-title);
}

.history-source-row,
.form-source-text,
.tenant-section-source {
  color: var(--dhic-text-secondary);
  font-weight: var(--dhic-weight-heading);
}

.history-scope-tip,
.tenant-history-identity,
.tenant-form-tip,
.empty-desc {
  display: -webkit-box;
  overflow: hidden;
  color: var(--dhic-text-secondary);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.history-source-count,
.tenant-history-count,
.tenant-required-tip,
.public-visitor-badge {
  border: 0;
  color: var(--dhic-tech-primary);
  background: var(--dhic-tech-soft);
  font-weight: var(--dhic-weight-heading);
}

.compact-history-card,
.tenant-history-item {
  border: 0;
  border-radius: var(--dhic-radius-section);
  background: var(--dhic-surface-raised);
  box-shadow: 0 6rpx 18rpx rgba(var(--dhic-ink-rgb), 0.05);
}

.compact-history-card:active,
.tenant-history-item:active {
  border: 0;
  background: var(--dhic-tech-soft);
  box-shadow: var(--dhic-shadow-card-hover);
}

.compact-history-card .visitor-title,
.tenant-history-item .visitor-title,
.visitor-title {
  color: var(--dhic-text-heading);
  font-weight: var(--dhic-weight-heading);
}

.compact-history-card .visitor-phone,
.compact-history-card .visitor-meta,
.tenant-history-item .visitor-phone,
.tenant-history-item .visitor-meta,
.tenant-visitor-facts {
  color: var(--dhic-text-secondary);
}

.compact-history-card .visitor-desc,
.tenant-visitor-desc,
.visitor-desc,
.visitor-remark {
  display: -webkit-box;
  overflow: hidden;
  color: var(--dhic-text-heading);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.status,
.review-tip {
  border-radius: var(--dhic-radius-pill);
  font-weight: var(--dhic-weight-heading);
}

.tenant-detail-hint,
.qr-longpress-tip {
  color: var(--dhic-text-secondary);
}

.visitor-process {
  border: 0;
  border-radius: var(--dhic-radius-panel);
  background:
    linear-gradient(90deg, rgba(var(--dhic-accent-rgb), 0.04) 1rpx, transparent 1rpx),
    var(--dhic-surface-subtle);
  background-size: 32rpx 100%;
}

.visitor-process-item {
  color: var(--dhic-text-secondary);
}

.public-field-grid .public-input,
.public-visitor-page .textarea,
.input,
.textarea,
.picker-input {
  border-color: var(--dhic-border);
  border-radius: var(--dhic-radius-card);
  background: var(--dhic-surface-subtle);
}

.public-privacy-tip {
  border-left-color: var(--dhic-tech-primary);
  border-radius: var(--dhic-radius-card);
  color: var(--dhic-text-secondary);
}

.tenant-submit-button,
.public-submit-button,
.qr-button,
.qr-close-button,
.cancel-button {
  border-radius: var(--dhic-radius-card);
  font-weight: var(--dhic-weight-heading);
}

.qr-dialog {
  border: 0;
  border-radius: var(--dhic-radius-section);
  box-shadow: var(--dhic-shadow-raised);
}

.qr-dialog-title {
  color: var(--dhic-text-primary);
  font-weight: var(--dhic-weight-title);
}
