<view class="page mine-page">
  <view wx:if="{{pageState === 'loading'}}" class="card state-panel" aria-busy="true">
    <view class="state-title">正在确认当前身份</view>
    <view class="state-description">正在同步账号会话和租户信息。</view>
  </view>

  <view wx:elif="{{pageState === 'error' || pageState === 'login-required' || pageState === 'unauthorized'}}" class="card state-panel error-panel">
    <view class="state-title">身份信息暂时无法加载</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="outline-button state-button" bindtap="refresh">重新加载</button>
  </view>

  <block wx:else>
    <view class="card profile-card">
      <view class="profile-header">
        <view class="avatar-wrap {{isTenant ? 'avatar-wrap-square' : ''}} {{isTenant && !tenantLogoPath ? 'avatar-wrap-empty' : ''}}">
          <image wx:if="{{isTenant && tenantLogoPath}}" class="avatar" src="{{tenantLogoPath}}" mode="aspectFit" />
          <image wx:elif="{{!isTenant}}" class="avatar" src="/assets/dehui-logo.png" mode="aspectFit" />
        </view>
        <view class="profile-meta">
          <view class="profile-title">我的身份</view>
          <view class="profile-identity">{{identityText}}</view>
          <view class="profile-tags">
            <text class="status-label {{isTenant ? 'bound' : 'not-bound'}}">账号状态：{{accountStatusText}}</text>
          </view>
        </view>
      </view>

      <view class="tenant-summary" wx:if="{{isTenant}}">
        <view class="tenant-row" wx:if="{{tenantName}}">
          <text class="tenant-label">所属企业</text>
          <text class="tenant-value">{{tenantName}}</text>
        </view>
        <view class="tenant-row" wx:if="{{contactName}}">
          <text class="tenant-label">联系人</text>
          <text class="tenant-value">{{contactName}}</text>
        </view>
        <view class="tenant-row" wx:if="{{contactPhone}}">
          <text class="tenant-label">手机号</text>
          <text class="tenant-value">{{contactPhone}}</text>
        </view>
      </view>
    </view>

    <view class="card list-section identity-section">
      <view class="section-title">身份管理</view>
      <button
        class="list-item"
        bindtap="openAccount"
        hover-class="list-item-active"
        aria-label="{{accountActionText}}，{{identityStatus}}"
      >
        <view class="item-left">
          <view class="item-icon">账</view>
          <view class="item-content">
            <view class="item-title">{{accountActionText}}</view>
            <view class="item-subtitle">{{identityDescription}}</view>
          </view>
        </view>
        <view class="item-right">
          <text class="item-value {{isTenant ? 'bound' : 'not-bound'}}">{{accountStatusText}}</text>
          <text class="cell-arrow">›</text>
        </view>
      </button>
    </view>

    <view class="card list-section" wx:if="{{isTenant}}">
      <view class="section-title">我的业务</view>
      <view wx:if="{{businessCards.length}}">
        <button
          wx:for="{{businessCards}}"
          wx:key="key"
          class="list-item"
          data-key="{{item.key}}"
          bindtap="openBusiness"
          hover-class="list-item-active"
          aria-label="{{item.title}}，{{item.description}}"
        >
          <view class="item-left">
            <view class="item-icon">{{item.label}}</view>
            <view class="item-content">
              <view class="item-title">{{item.title}}</view>
              <view class="item-subtitle">{{item.description}}</view>
            </view>
          </view>
          <view class="item-right">
            <text class="cell-arrow">›</text>
          </view>
        </button>
      </view>

      <view wx:else class="empty-panel">
        <view class="empty-title">暂无可用租户服务</view>
        <view class="empty-description">当前身份暂未获得对应业务能力，请联系物业确认账号权限。</view>
      </view>
    </view>

    <view class="card list-section" wx:if="{{isStaff}}">
      <view class="section-title">物业工作台</view>
      <button
        wx:for="{{businessCards}}"
        wx:key="key"
        class="list-item"
        data-key="{{item.key}}"
        bindtap="openBusiness"
        hover-class="list-item-active"
      >
        <view class="item-left">
          <view class="item-icon">{{item.label}}</view>
          <view class="item-content">
            <view class="item-title">{{item.title}}</view>
            <view class="item-subtitle">{{item.description}}</view>
          </view>
        </view>
        <view class="item-right"><text class="cell-arrow">›</text></view>
      </button>
      <view wx:if="{{!businessCards.length}}" class="empty-panel">
        <view class="empty-title">暂无已授权移动功能</view>
        <view class="empty-description">请联系管理员确认后台角色权限。</view>
      </view>
    </view>
  </block>

  <view class="card list-section legal-section">
    <view class="section-title">服务说明</view>
    <button class="list-item" bindtap="openServiceAgreement" hover-class="list-item-active">
      <view class="item-left">
        <view class="item-icon">协</view>
        <view class="item-content">
          <view class="item-title">用户服务协议</view>
          <view class="item-subtitle">查看平台服务条款与使用规则</view>
        </view>
      </view>
      <view class="item-right">
        <text class="cell-arrow">›</text>
      </view>
    </button>
    <button class="list-item" bindtap="openPrivacyPolicy" hover-class="list-item-active">
      <view class="item-left">
        <view class="item-icon">隐</view>
        <view class="item-content">
          <view class="item-title">用户隐私保护指引</view>
          <view class="item-subtitle">了解个人信息的收集与使用范围</view>
        </view>
      </view>
      <view class="item-right">
        <text class="cell-arrow">›</text>
      </view>
    </button>
  </view>
</view>
