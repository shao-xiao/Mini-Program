.account-page {
  padding: 24rpx 24rpx calc(64rpx + env(safe-area-inset-bottom));
}

.login-card,
.account-card,
.legal-card,
.state-panel {
  margin-bottom: 24rpx;
  border: 1rpx solid var(--dhic-border-light);
  border-radius: 20rpx;
  background: var(--dhic-surface);
}

.login-card,
.account-card {
  padding: 36rpx 30rpx;
  border-top: 6rpx solid var(--dhic-brand-primary);
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.brand-logo {
  width: 440rpx;
  height: 92rpx;
  max-width: 100%;
  display: block;
}

.brand-kicker,
.account-kicker {
  margin-top: 34rpx;
  color: var(--dhic-brand-primary);
  font-size: 22rpx;
  font-weight: var(--dhic-weight-data);
  letter-spacing: 1rpx;
}

.brand-title,
.account-title {
  margin-top: 8rpx;
  color: var(--dhic-text-primary);
  font-size: 38rpx;
  font-weight: var(--dhic-weight-data);
  line-height: 1.3;
}

.brand-description {
  margin-top: 16rpx;
  color: var(--dhic-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.primary-button,
.logout-button,
.outline-button {
  width: 100%;
  height: 92rpx;
  margin: 34rpx 0 0;
  border-radius: 10rpx;
  font-size: 29rpx;
  font-weight: var(--dhic-weight-data);
  line-height: 92rpx;
}

.primary-button {
  color: var(--dhic-text-inverse);
  background: var(--dhic-action-primary);
}

.logout-button {
  color: var(--dhic-danger);
  background: var(--dhic-danger-soft);
}

.outline-button {
  color: var(--dhic-tech-primary);
  background: var(--dhic-surface);
  border: 1rpx solid var(--dhic-border-strong);
}

.primary-button::after,
.logout-button::after,
.outline-button::after,
.legal-item::after {
  border: 0;
}

.agreement-bar {
  margin-top: 28rpx;
}

.agreement-checkbox-group {
  display: block;
}

.agreement-label {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.agreement-checkbox {
  flex: none;
  margin-top: 2rpx;
  transform: scale(0.76);
  transform-origin: top left;
}

.agreement-text {
  min-width: 0;
  color: var(--dhic-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
}

.agreement-link {
  color: var(--dhic-tech-primary);
  font-weight: var(--dhic-weight-heading);
}

.account-header {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.account-logo-wrap {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  border-radius: 18rpx;
  background: var(--dhic-brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.account-logo {
  width: 76rpx;
  height: 76rpx;
  display: block;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-copy .account-kicker {
  margin-top: 0;
}

.account-status {
  margin-top: 6rpx;
  color: var(--dhic-text-secondary);
  font-size: 24rpx;
}

.internal-notice {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  color: var(--dhic-tech-primary);
  background: var(--dhic-tech-soft);
  font-size: 24rpx;
  line-height: 1.55;
}

.account-details {
  margin-top: 28rpx;
  padding: 6rpx 22rpx;
  border-radius: 14rpx;
  background: var(--dhic-page-bg);
}

.detail-row {
  min-height: 80rpx;
  border-bottom: 1rpx solid var(--dhic-border-light);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30rpx;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  flex: none;
  color: var(--dhic-text-secondary);
  font-size: 24rpx;
}

.detail-value {
  color: var(--dhic-text-primary);
  font-size: 25rpx;
  font-weight: var(--dhic-weight-heading);
  text-align: right;
  word-break: break-all;
}

.legal-card {
  padding: 20rpx 28rpx 0;
}

.legal-heading {
  padding: 8rpx 0 18rpx;
  color: var(--dhic-text-primary);
  font-size: 30rpx;
  font-weight: var(--dhic-weight-data);
}

.legal-item {
  width: 100%;
  min-height: 92rpx;
  margin: 0;
  padding: 18rpx 0;
  border: 0;
  border-top: 1rpx solid var(--dhic-border-light);
  border-radius: 0;
  box-sizing: border-box;
  color: var(--dhic-text-primary);
  background: var(--dhic-surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  line-height: normal;
  text-align: left;
}

.legal-arrow {
  color: var(--dhic-text-disabled);
  font-size: 38rpx;
  line-height: 1;
}

.state-panel {
  padding: 36rpx 30rpx;
}

.error-panel {
  border-top: 6rpx solid var(--dhic-danger);
}

.state-title {
  color: var(--dhic-text-primary);
  font-size: 29rpx;
  font-weight: var(--dhic-weight-data);
}

.state-description {
  margin-top: 10rpx;
  color: var(--dhic-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.retry-button {
  width: 220rpx;
}

/* Phase 2: DHIC account service visual refinement. */
page {
  --dhic-page-action-primary: var(--dhic-tech-primary);
  --dhic-page-action-soft: var(--dhic-tech-soft);
  --dhic-page-action-rgb: var(--dhic-tech-primary-rgb);
}

.account-page {
  background: var(--dhic-page-bg);
}

.login-card,
.account-card,
.legal-card,
.state-panel {
  margin-bottom: 18rpx;
  border: 1rpx solid var(--dhic-border-card);
  border-radius: var(--dhic-radius-panel);
  background: var(--dhic-surface);
  box-shadow: none;
}

.login-card,
.account-card {
  padding: 28rpx;
  border-top: 0;
}

.brand-kicker,
.account-kicker {
  color: var(--dhic-tech-primary);
  font-size: var(--dhic-font-meta);
  font-weight: var(--dhic-weight-heading);
}

.brand-title,
.account-title {
  color: var(--dhic-text-primary);
  font-size: var(--dhic-font-hero);
  font-weight: var(--dhic-weight-title);
}

.brand-description {
  display: -webkit-box;
  overflow: hidden;
  color: var(--dhic-text-secondary);
  font-size: var(--dhic-font-body);
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.primary-button,
.logout-button,
.outline-button {
  height: 80rpx;
  margin-top: 24rpx;
  border-radius: var(--dhic-radius-card);
  font-weight: var(--dhic-weight-heading);
  line-height: 80rpx;
}

.primary-button {
  box-shadow: none;
}

.logout-button {
  border: 1rpx solid rgba(var(--dhic-brand-rgb), 0.14);
}

.outline-button {
  border-color: var(--dhic-border);
  box-shadow: none;
}

.agreement-text {
  color: var(--dhic-text-secondary);
  font-size: var(--dhic-font-meta);
}

.account-logo-wrap {
  border: 1rpx solid var(--dhic-border-light);
  border-radius: var(--dhic-radius-panel);
  background: var(--dhic-surface-subtle);
  box-shadow: none;
}

.account-status {
  color: var(--dhic-text-secondary);
  font-size: var(--dhic-font-body);
}

.internal-notice {
  border-radius: var(--dhic-radius-panel);
  color: var(--dhic-text-heading);
  background: var(--dhic-tech-soft);
}

.account-details {
  margin-top: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--dhic-radius-panel);
  background: var(--dhic-surface-subtle);
}

.detail-row {
  min-height: 72rpx;
}

.account-card > .account-kicker {
  margin-top: 0;
}

.account-card .outline-button.retry-button {
  width: 100%;
  margin-top: 16rpx;
}

.account-page > .outline-button.retry-button {
  width: 100%;
  margin: 0 0 16rpx;
}

.account-page > .logout-button {
  width: 100%;
  margin: 0 0 18rpx;
}

.detail-label {
  color: var(--dhic-text-secondary);
}

.detail-value {
  color: var(--dhic-text-heading);
  font-weight: var(--dhic-weight-heading);
}

.legal-heading {
  color: var(--dhic-text-primary);
  font-size: var(--dhic-font-title);
  font-weight: var(--dhic-weight-title);
}

.legal-item {
  min-height: 80rpx;
  color: var(--dhic-text-heading);
  font-size: var(--dhic-font-body-lg);
  font-weight: var(--dhic-weight-heading);
}

.legal-arrow {
  color: var(--dhic-text-tertiary);
}

.state-title {
  color: var(--dhic-text-primary);
  font-weight: var(--dhic-weight-title);
}

.state-description {
  display: -webkit-box;
  overflow: hidden;
  color: var(--dhic-text-secondary);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
