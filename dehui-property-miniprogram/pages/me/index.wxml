<view class="page account-page">
  <view wx:if="{{pageState === 'loading'}}" class="state-panel" aria-busy="true">
    <view class="state-title">正在确认账号状态</view>
    <view class="state-description">正在同步账号会话与业务身份。</view>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="state-panel error-panel">
    <view class="state-title">账号状态暂时无法加载</view>
    <view class="state-description">{{errorMessage}}</view>
    <button class="outline-button retry-button" bindtap="refreshIdentity">重新加载</button>
  </view>

  <block wx:else>
    <view class="account-card">
      <view class="account-header">
        <view class="account-logo-wrap">
          <image class="account-logo" src="/assets/dehui-logo.png" mode="aspectFit" />
        </view>
        <view class="account-copy">
          <view class="account-kicker">账号详情</view>
          <view class="account-title">{{identityText}}</view>
          <view class="account-status">{{statusText}}</view>
        </view>
      </view>

      <view class="account-details">
        <view class="detail-row" wx:if="{{contactName}}">
          <text class="detail-label">姓名</text>
          <text class="detail-value">{{contactName}}</text>
        </view>
        <view class="detail-row" wx:if="{{phone}}">
          <text class="detail-label">手机号</text>
          <text class="detail-value">{{phone}}</text>
        </view>
        <view class="detail-row" wx:if="{{tenantName}}">
          <text class="detail-label">企业</text>
          <text class="detail-value">{{tenantName}}</text>
        </view>
        <view class="detail-row" wx:if="{{contactRoleLabel}}">
          <text class="detail-label">联系人类型</text>
          <text class="detail-value">{{contactRoleLabel}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{userType === 'PUBLIC'}}" class="login-card">
      <view class="brand-block">
        <view class="brand-title">手机号快捷登录</view>
        <view class="brand-description">登录成功后，系统将使用已验证手机号匹配租户联系人或已启用移动工作台的物业员工。</view>
      </view>
      <button
        wx:if="{{agreementsAccepted}}"
        class="primary-button"
        open-type="getPhoneNumber"
        bindgetphonenumber="loginWithPhoneNumber"
        loading="{{phoneLoginLoading}}"
      >手机号快捷登录</button>
      <button wx:else class="primary-button" bindtap="promptAgreementRequired">手机号快捷登录</button>
      <checkbox-group class="agreement-checkbox-group" bindchange="onAgreementChange">
        <label class="agreement-label">
          <checkbox value="accepted" checked="{{agreementsAccepted}}" color="#D71920" />
          <view class="agreement-text">我已阅读并同意服务协议和隐私保护指引</view>
        </label>
      </checkbox-group>
    </view>

    <view wx:if="{{showIdentitySelector}}" class="account-card">
      <view class="account-kicker">身份切换</view>
      <button
        wx:for="{{availableIdentities}}"
        wx:key="candidateToken"
        class="outline-button retry-button"
        data-token="{{item.candidateToken}}"
        bindtap="chooseIdentity"
        loading="{{identityLoading}}"
      >{{item.label}} · {{item.userType === 'STAFF' ? '物业员工' : (item.contactRole === 'RESPONSIBLE' ? '租户负责人' : '租户员工')}}</button>
    </view>

    <button
      wx:if="{{userType !== 'PUBLIC'}}"
      class="outline-button retry-button"
      bindtap="unbindCurrent"
      loading="{{unbindLoading}}"
    >解除当前业务绑定</button>
    <button
      wx:if="{{sessionState === 'AUTHENTICATED' || userType !== 'PUBLIC'}}"
      class="logout-button"
      bindtap="logout"
      loading="{{logoutLoading}}"
    >退出登录</button>
  </block>

  <view class="legal-card">
    <view class="legal-heading">服务与隐私</view>
    <button class="legal-item" bindtap="openServiceAgreement"><text>用户服务协议</text></button>
    <button class="legal-item" bindtap="openPrivacyPolicy"><text>用户隐私保护指引</text></button>
  </view>
</view>
