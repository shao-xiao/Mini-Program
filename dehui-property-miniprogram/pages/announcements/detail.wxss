page {
  --dhic-page-action-primary: var(--dhic-info);
  --dhic-page-action-soft: var(--dhic-info-soft);
  --dhic-page-action-rgb: var(--dhic-info-rgb);
}

.card {
  border: 0;
  border-radius: var(--dhic-radius-section);
  box-shadow: var(--dhic-shadow-section);
}

.detail-type {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-brand-soft);
  color: var(--dhic-brand-primary);
  font-weight: var(--dhic-weight-heading);
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.detail-cover {
  width: 100%;
  height: 360rpx;
  margin-bottom: 24rpx;
  border-radius: var(--dhic-radius-section);
}

.detail-summary {
  margin-top: 16rpx;
  color: var(--dhic-text-heading);
  font-size: 26rpx;
  font-weight: var(--dhic-weight-heading);
  line-height: 1.6;
}

.detail-content {
  margin-top: 32rpx;
  color: var(--dhic-text-primary);
  font-size: 30rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.state-card {
  padding: 40rpx 28rpx;
  text-align: center;
}

.state-title {
  color: var(--dhic-text-heading);
  font-size: 30rpx;
  font-weight: var(--dhic-weight-heading);
}

.state-desc {
  margin-top: 12rpx;
  color: var(--dhic-text-secondary);
  font-size: 25rpx;
  line-height: 1.55;
}

.state-action {
  width: 240rpx;
  margin-top: 24rpx;
}
