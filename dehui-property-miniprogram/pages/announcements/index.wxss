page {
  --dhic-page-action-primary: var(--dhic-info);
  --dhic-page-action-soft: var(--dhic-info-soft);
  --dhic-page-action-rgb: var(--dhic-info-rgb);
}

.announcement-page {
  background:
    linear-gradient(180deg, rgba(var(--dhic-accent-rgb), 0.06), rgba(var(--dhic-white-rgb), 0) 360rpx),
    var(--dhic-page-bg);
}

.announcement-overview {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 4rpx 4rpx 18rpx;
}

.overview-label {
  color: var(--dhic-tech-primary);
  font-size: 19rpx;
  font-weight: var(--dhic-weight-heading);
  letter-spacing: 2rpx;
}

.overview-title {
  margin-top: 4rpx;
  color: var(--dhic-text-primary);
  font-size: 30rpx;
  font-weight: var(--dhic-weight-title);
}

.overview-count {
  padding: 7rpx 14rpx;
  border: 0;
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-tech-soft);
  color: var(--dhic-tech-600);
  font-size: 21rpx;
  font-weight: var(--dhic-weight-data);
}

.announcement-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--dhic-surface);
  border: 0;
  border-radius: var(--dhic-radius-section);
  padding: 0 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--dhic-shadow-card);
}

.announcement-card::before {
  position: absolute;
  top: 0;
  left: 0;
  width: 5rpx;
  height: 78rpx;
  background: linear-gradient(180deg, var(--dhic-tech-cyan), var(--dhic-tech-500));
  content: "";
}

.announcement-source {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 54rpx;
  color: var(--dhic-text-secondary);
  font-size: 20rpx;
}

.source-node,
.time-node {
  flex: none;
  width: 7rpx;
  height: 7rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: var(--dhic-tech-cyan);
  box-shadow: 0 0 10rpx rgba(var(--dhic-accent-rgb), 0.6);
}

.source-sequence {
  overflow: hidden;
  max-width: 210rpx;
  margin-left: auto;
  color: var(--dhic-text-tertiary);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.announcement-body {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}

.announcement-copy {
  flex: 1;
  min-width: 0;
}

.announcement-cover {
  flex: none;
  width: 154rpx;
  height: 142rpx;
  border: 1rpx solid var(--dhic-border);
  border-radius: var(--dhic-radius-control);
  background: var(--dhic-neutral-soft);
}

.announcement-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.announcement-title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 11rpx;
  font-size: 29rpx;
  font-weight: var(--dhic-weight-heading);
  color: var(--dhic-text-heading);
  line-height: 1.38;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.announcement-type {
  flex: none;
  padding: 5rpx 12rpx;
  border: 0;
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-tech-soft);
  color: var(--dhic-tech-500);
  font-size: 20rpx;
  font-weight: var(--dhic-weight-heading);
}

.announcement-sync {
  color: var(--dhic-success);
  font-size: 19rpx;
  font-weight: var(--dhic-weight-heading);
}

.announcement-content {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: var(--dhic-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.announcement-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid var(--dhic-border-light);
}

.announcement-time {
  display: flex;
  align-items: center;
  color: var(--dhic-text-secondary);
  font-size: 20rpx;
}

.time-node {
  width: 6rpx;
  height: 6rpx;
  background: var(--dhic-text-tertiary);
  box-shadow: none;
}

.announcement-action {
  flex: none;
  color: var(--dhic-action-primary);
  font-size: 21rpx;
  font-weight: var(--dhic-weight-heading);
}

.state-card {
  padding: 40rpx 28rpx;
  text-align: center;
}

.state-title {
  color: var(--dhic-text-heading);
  font-size: 30rpx;
  font-weight: var(--dhic-weight-heading);
}

.state-desc {
  margin-top: 12rpx;
  color: var(--dhic-text-secondary);
  font-size: 25rpx;
  line-height: 1.55;
}

.state-action {
  width: 240rpx;
  margin-top: 24rpx;
}
