@import "../../styles/theme.wxss";

.field {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  color: var(--dhic-text-heading);
  font-size: var(--dhic-font-body-lg);
  font-weight: var(--dhic-weight-heading);
}

.required,
.error {
  color: var(--dhic-danger);
}

.field-control,
.picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 18rpx;
  border: 1rpx solid var(--dhic-border-light);
  border-radius: var(--dhic-radius-control);
  background: var(--dhic-surface-subtle);
  color: var(--dhic-text-primary);
  font-size: var(--dhic-font-body-lg);
  font-weight: var(--dhic-weight-body);
}

.field-control[disabled] {
  border-color: var(--dhic-border-light);
  background: var(--dhic-surface-muted);
  color: var(--dhic-text-disabled);
}

.field-textarea {
  height: 180rpx;
}

.help {
  margin-top: 8rpx;
  color: var(--dhic-text-tertiary);
  font-size: var(--dhic-font-meta);
  font-weight: var(--dhic-weight-body);
}

.error {
  margin-top: 8rpx;
  font-size: var(--dhic-font-meta);
  font-weight: var(--dhic-weight-medium);
}

.files {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.file {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--dhic-text-secondary);
  font-size: var(--dhic-font-body);
}

.file-preview {
  width: 140rpx;
  height: 140rpx;
  border: 1rpx solid var(--dhic-border-light);
  border-radius: var(--dhic-radius-control);
  background: var(--dhic-surface-muted);
}

.files button {
  margin: 0;
  border: 1rpx solid var(--dhic-border);
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-action-soft);
  color: var(--dhic-action-primary);
  font-size: var(--dhic-font-meta);
  font-weight: var(--dhic-weight-medium);
}

.files button::after {
  border: 0;
}

.files button[data-index] {
  border-color: var(--dhic-danger-soft);
  background: var(--dhic-danger-soft);
  color: var(--dhic-danger);
}

.dynamic-form--compact {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx 16rpx;
}

.dynamic-form--compact .field {
  min-width: 0;
  margin-bottom: 0;
}

.dynamic-form--compact .field-TEXTAREA,
.dynamic-form--compact .field-MULTISELECT,
.dynamic-form--compact .field-IMAGE,
.dynamic-form--compact .field-ATTACHMENT {
  grid-column: 1 / -1;
}

.dynamic-form--compact .label {
  margin-bottom: 6rpx;
  overflow: hidden;
  color: var(--dhic-text-heading);
  font-size: var(--dhic-font-body);
  font-weight: var(--dhic-weight-heading);
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dynamic-form--compact .field-control,
.dynamic-form--compact .picker {
  min-height: 68rpx;
  padding: 12rpx 14rpx;
  border-color: var(--dhic-border-light);
  border-radius: var(--dhic-radius-control);
  background: var(--dhic-surface-subtle);
  font-size: var(--dhic-font-body);
}

.dynamic-form--compact .field-textarea {
  height: 92rpx;
  min-height: 92rpx;
  line-height: 32rpx;
}

.dynamic-form--compact .field-key-visitReason .field-textarea {
  height: 108rpx;
  min-height: 108rpx;
}

.dynamic-form--compact .help,
.dynamic-form--compact .error {
  margin-top: 4rpx;
  font-size: var(--dhic-font-caption);
  line-height: 28rpx;
}
