@import "../../styles/theme.wxss";

.source-panel {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 212rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(var(--dhic-accent-rgb), 0.28);
  border-radius: var(--dhic-radius-section);
  background: var(--dhic-gradient-tech);
  box-shadow: 0 14rpx 34rpx rgba(var(--dhic-tech-rgb), 0.2);
  color: var(--dhic-text-inverse);
}

.source-panel.tone-secure {
  background: linear-gradient(
    135deg,
    var(--dhic-tech-950) 0%,
    var(--dhic-tech-900) 62%,
    var(--dhic-tech-800) 100%
  );
}

.source-panel.tone-service {
  background: linear-gradient(
    135deg,
    var(--dhic-tech-900) 0%,
    var(--dhic-tech-800) 58%,
    var(--dhic-tech-primary) 100%
  );
}

.source-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0.12;
  background-image:
    linear-gradient(rgba(var(--dhic-accent-rgb), 0.35) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(var(--dhic-accent-rgb), 0.35) 1rpx, transparent 1rpx);
  background-size: 34rpx 34rpx;
}

.source-orbit {
  position: absolute;
  border: 1rpx solid rgba(var(--dhic-accent-rgb), 0.28);
  border-radius: var(--dhic-radius-pill);
}

.source-orbit-one {
  top: -92rpx;
  right: -34rpx;
  width: 250rpx;
  height: 250rpx;
}

.source-orbit-two {
  right: 24rpx;
  bottom: -104rpx;
  width: 188rpx;
  height: 188rpx;
}

.source-content {
  position: relative;
  z-index: 1;
}

.source-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.source-copy {
  min-width: 0;
}

.source-kicker {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: rgba(var(--dhic-white-rgb), 0.76);
  font-size: var(--dhic-font-caption);
  font-weight: var(--dhic-weight-heading);
  letter-spacing: 2rpx;
}

.source-signal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18rpx;
  height: 18rpx;
  border: 1rpx solid rgba(var(--dhic-accent-rgb), 0.7);
  border-radius: var(--dhic-radius-pill);
}

.source-signal-core,
.source-status-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-tech-cyan);
  box-shadow: 0 0 14rpx rgba(var(--dhic-accent-rgb), 0.9);
}

.source-title {
  margin-top: 14rpx;
  font-size: var(--dhic-font-hero);
  font-weight: var(--dhic-weight-title);
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.source-description {
  max-width: 500rpx;
  margin-top: 9rpx;
  color: rgba(var(--dhic-white-rgb), 0.84);
  font-size: var(--dhic-font-body);
  font-weight: var(--dhic-weight-body);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.source-status {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(var(--dhic-accent-rgb), 0.32);
  border-radius: var(--dhic-radius-pill);
  background: rgba(var(--dhic-ink-rgb), 0.24);
  color: var(--dhic-text-inverse);
  font-size: var(--dhic-font-caption);
  font-weight: var(--dhic-weight-medium);
}

.source-trace {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  margin-top: 22rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid rgba(var(--dhic-white-rgb), 0.16);
}

.source-trace-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  gap: 5rpx;
}

.source-scope-item {
  flex: 1;
}

.source-trace-label {
  flex: none;
  color: rgba(var(--dhic-white-rgb), 0.70);
  font-size: var(--dhic-font-caption);
  font-weight: var(--dhic-weight-body);
}

.source-trace-value {
  color: var(--dhic-text-inverse);
  font-size: var(--dhic-font-meta);
  font-weight: var(--dhic-weight-heading);
  line-height: 1.35;
}

.source-trace-divider {
  flex: none;
  width: 1rpx;
  height: 24rpx;
  background: rgba(var(--dhic-white-rgb), 0.2);
}
