.time-field {
  width: 100%;
}

.time-trigger {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f5f6f8;
  box-sizing: border-box;
  color: #1f1b1b;
  font-size: 26rpx;
  line-height: 1.4;
}

.time-placeholder {
  color: #a8abb2;
}

.time-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.12);
}

.time-panel {
  width: 100%;
  max-width: 680rpx;
  padding: 20rpx 20rpx 18rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 18rpx 52rpx rgba(15, 23, 42, 0.14);
}

.time-toolbar {
  padding: 8rpx 4rpx 14rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.time-title {
  color: #1f1b1b;
  font-size: 30rpx;
  font-weight: 700;
}

.time-picker-view {
  width: 100%;
  height: 320rpx;
  margin-top: 12rpx;
}

.time-picker-indicator {
  height: 72rpx;
  border-top: 1rpx solid #f0f2f5;
  border-bottom: 1rpx solid #f0f2f5;
}

.time-option {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: #1f1b1b;
  font-size: 28rpx;
}

.time-footer {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
}

.time-button {
  min-width: 120rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  text-align: center;
}

.time-button--muted {
  background: #f5f6f8;
  color: #606266;
}

.time-button--primary {
  background: #2f6df6;
  color: #ffffff;
}
