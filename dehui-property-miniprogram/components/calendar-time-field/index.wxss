@import "../../styles/theme.wxss";

.time-field {
  width: 100%;
}

.time-trigger {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--dhic-border-light);
  border-radius: var(--dhic-radius-control);
  background: var(--dhic-surface-muted);
  box-sizing: border-box;
  color: var(--dhic-text-primary);
  font-size: var(--dhic-font-body-lg);
  font-weight: var(--dhic-weight-body);
  line-height: 1.4;
}

.time-placeholder {
  color: var(--dhic-text-tertiary);
}

.time-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(var(--dhic-ink-rgb), 0.12);
}

.time-panel {
  width: 100%;
  max-width: 680rpx;
  padding: 20rpx 20rpx 18rpx;
  border-radius: var(--dhic-radius-section);
  box-sizing: border-box;
  background: var(--dhic-surface);
  box-shadow: var(--dhic-shadow-raised);
}

.time-toolbar {
  padding: 8rpx 4rpx 14rpx;
  border-bottom: 1rpx solid var(--dhic-border-light);
}

.time-title {
  color: var(--dhic-text-primary);
  font-size: var(--dhic-font-title);
  font-weight: var(--dhic-weight-title);
}

.time-picker-view {
  width: 100%;
  height: 320rpx;
  margin-top: 12rpx;
}

.time-picker-indicator {
  height: 72rpx;
  border-top: 1rpx solid var(--dhic-border-light);
  border-bottom: 1rpx solid var(--dhic-border-light);
}

.time-option {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: var(--dhic-text-primary);
  font-size: var(--dhic-font-emphasis);
  font-weight: var(--dhic-weight-medium);
}

.time-footer {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
}

.time-button {
  min-width: 120rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid transparent;
  border-radius: var(--dhic-radius-pill);
  font-size: var(--dhic-font-body);
  font-weight: var(--dhic-weight-medium);
  text-align: center;
}

.time-button--muted {
  border-color: var(--dhic-border-light);
  background: var(--dhic-surface-muted);
  color: var(--dhic-text-secondary);
}

.time-button--primary {
  background: var(--dhic-action-primary);
  color: var(--dhic-text-inverse);
  box-shadow: var(--dhic-shadow-focus);
}
