<view class="calendar-field">
  <view class="calendar-trigger {{displayValue ? '' : 'calendar-placeholder'}}" bindtap="openPanel">
    {{displayValue || placeholder}}
  </view>

  <view wx:if="{{visible}}" class="calendar-mask" bindtap="closePanel">
    <view class="calendar-panel" catchtap="stopPanelTap">
      <view class="calendar-toolbar">
        <view class="calendar-title">{{headerText}}</view>
        <view class="calendar-nav">
          <view class="nav-button" bindtap="prevMonth">‹</view>
          <view class="nav-button" bindtap="nextMonth">›</view>
        </view>
      </view>

      <view class="week-header">
        <view wx:for="{{weekDays}}" wx:key="*this" class="week-cell">{{item}}</view>
      </view>

      <view class="day-grid">
        <view
          wx:for="{{days}}"
          wx:key="key"
          class="day-cell {{item.currentMonth ? '' : 'day-cell--muted'}} {{item.selected ? 'day-cell--selected' : ''}} {{item.today ? 'day-cell--today' : ''}} {{item.disabled ? 'day-cell--disabled' : ''}}"
          data-value="{{item.dateValue}}"
          data-disabled="{{item.disabled}}"
          bindtap="selectDay"
        >
          {{item.text}}
        </view>
      </view>

      <view class="calendar-footer">
        <view class="footer-button" bindtap="closePanel">关闭</view>
      </view>
    </view>
  </view>
</view>
