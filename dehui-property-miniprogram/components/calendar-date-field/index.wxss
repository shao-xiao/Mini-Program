@import "../../styles/theme.wxss";

.calendar-field {
  width: 100%;
}

.calendar-trigger {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--dhic-border-light);
  border-radius: var(--dhic-radius-control);
  background: var(--dhic-surface-muted);
  box-sizing: border-box;
  color: var(--dhic-text-primary);
  font-size: var(--dhic-font-body-lg);
  font-weight: var(--dhic-weight-body);
  line-height: 1.4;
}

.calendar-placeholder {
  color: var(--dhic-text-tertiary);
}

.calendar-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(var(--dhic-ink-rgb), 0.12);
}

.calendar-panel {
  width: 100%;
  max-width: 680rpx;
  padding: 20rpx 20rpx 18rpx;
  border-radius: var(--dhic-radius-section);
  box-sizing: border-box;
  background: var(--dhic-surface);
  box-shadow: var(--dhic-shadow-raised);
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 4rpx 14rpx;
  border-bottom: 1rpx solid var(--dhic-border-light);
}

.calendar-title {
  color: var(--dhic-text-primary);
  font-size: var(--dhic-font-title);
  font-weight: var(--dhic-weight-title);
}

.calendar-nav {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.nav-button {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-action-soft);
  color: var(--dhic-action-primary);
  font-size: var(--dhic-font-emphasis);
  font-weight: var(--dhic-weight-medium);
  line-height: 48rpx;
  text-align: center;
}

.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 18rpx;
}

.week-cell {
  color: var(--dhic-text-tertiary);
  font-size: var(--dhic-font-meta);
  font-weight: var(--dhic-weight-medium);
  text-align: center;
}

.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 14rpx;
}

.day-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  border-radius: var(--dhic-radius-card);
  color: var(--dhic-text-primary);
  font-size: var(--dhic-font-emphasis);
  font-weight: var(--dhic-weight-body);
}

.day-cell--muted {
  color: var(--dhic-text-disabled);
}

.day-cell--today {
  border: 2rpx solid rgba(var(--dhic-accent-rgb), 0.28);
}

.day-cell--selected {
  background: var(--dhic-tech-primary);
  color: var(--dhic-text-inverse);
  font-weight: var(--dhic-weight-heading);
  box-shadow: var(--dhic-shadow-focus);
}

.day-cell--disabled {
  color: var(--dhic-text-disabled);
}

.calendar-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.footer-button {
  min-width: 108rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--dhic-border-light);
  border-radius: var(--dhic-radius-pill);
  background: var(--dhic-surface-muted);
  color: var(--dhic-text-secondary);
  font-size: var(--dhic-font-body);
  font-weight: var(--dhic-weight-medium);
  text-align: center;
}
