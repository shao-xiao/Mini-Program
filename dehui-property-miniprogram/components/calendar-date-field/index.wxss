.calendar-field {
  width: 100%;
}

.calendar-trigger {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f5f6f8;
  box-sizing: border-box;
  color: #1f1b1b;
  font-size: 26rpx;
  line-height: 1.4;
}

.calendar-placeholder {
  color: #a8abb2;
}

.calendar-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.12);
}

.calendar-panel {
  width: 100%;
  max-width: 680rpx;
  padding: 20rpx 20rpx 18rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 18rpx 52rpx rgba(15, 23, 42, 0.14);
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 4rpx 14rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.calendar-title {
  color: #1f1b1b;
  font-size: 30rpx;
  font-weight: 700;
}

.calendar-nav {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.nav-button {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #1f1b1b;
  font-size: 28rpx;
  line-height: 48rpx;
  text-align: center;
}

.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 18rpx;
}

.week-cell {
  color: #909399;
  font-size: 22rpx;
  text-align: center;
}

.day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 14rpx;
}

.day-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  border-radius: 16rpx;
  color: #1f1b1b;
  font-size: 28rpx;
}

.day-cell--muted {
  color: #c0c4cc;
}

.day-cell--today {
  border: 2rpx solid rgba(47, 109, 246, 0.2);
}

.day-cell--selected {
  background: #2f6df6;
  color: #ffffff;
}

.day-cell--disabled {
  color: #dcdfe6;
}

.calendar-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.footer-button {
  min-width: 108rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #606266;
  font-size: 24rpx;
  text-align: center;
}
