<view class="page">
  <view wx:if="{{error}}" class="staff-empty">{{error}}</view>
  <view wx:if="{{detail}}" class="staff-record"><view class="staff-row"><view class="staff-record-title">{{detail.meetingRoomName}} · {{detail.tenantName || '内部预约'}}</view><view class="staff-status">{{detail.status}}</view></view><view class="staff-record-meta">{{detail.startTime}} - {{detail.endTime}}</view><view class="staff-record-meta">预约人：{{detail.applicantName}} {{detail.applicantPhone}}</view><view class="staff-record-meta">人数：{{detail.participantCount}}｜用途：{{detail.purpose}}｜费用：¥{{detail.amount}}</view><view class="staff-actions"><button wx:if="{{capabilities.confirm && (detail.status === 'PENDING' || detail.status === 'BOOKED')}}" class="staff-button" data-status="CONFIRMED" bindtap="change">确认</button><button wx:if="{{capabilities.complete && (detail.status === 'CONFIRMED' || detail.status === 'BOOKED')}}" class="staff-button" data-status="COMPLETED" bindtap="change">结束</button><button wx:if="{{capabilities.cancel && detail.status !== 'COMPLETED' && detail.status !== 'CANCELLED'}}" class="staff-button secondary" data-status="CANCELLED" bindtap="change">取消</button></view></view>
</view>
