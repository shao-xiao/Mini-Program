<view class="page">
  <view class="staff-header"><view class="staff-header-title">会议预约管理</view><view class="staff-header-desc">查看园区真实预约；费用收款仍由财务负责。</view></view>
  <view class="staff-filter"><view class="staff-filter-item {{status === '' ? 'active' : ''}}" data-status="" bindtap="filter">全部</view><view class="staff-filter-item {{status === 'PENDING' ? 'active' : ''}}" data-status="PENDING" bindtap="filter">待开始</view><view class="staff-filter-item {{status === 'CONFIRMED' ? 'active' : ''}}" data-status="CONFIRMED" bindtap="filter">已确认</view><view class="staff-filter-item {{status === 'COMPLETED' ? 'active' : ''}}" data-status="COMPLETED" bindtap="filter">已结束</view><view class="staff-filter-item {{status === 'CANCELLED' ? 'active' : ''}}" data-status="CANCELLED" bindtap="filter">已取消</view></view>
  <view wx:if="{{error}}" class="staff-empty">{{error}}</view>
  <view wx:for="{{records}}" wx:key="id" class="staff-record" data-id="{{item.id}}" bindtap="detail"><view class="staff-row"><view class="staff-record-title">{{item.meetingRoomName}} · {{item.tenantName || '内部预约'}}</view><view class="staff-status">{{item.status}}</view></view><view class="staff-record-meta">{{item.startTime}} - {{item.endTime}}</view><view class="staff-record-meta">{{item.contactName}} · {{item.participantCount}}人 · ¥{{item.amount}}</view></view>
  <view wx:if="{{loading}}" class="staff-empty">正在加载…</view><view wx:if="{{!loading && !records.length}}" class="staff-empty">暂无会议预约</view><view wx:if="{{!hasMore && records.length}}" class="more">没有更多了</view>
</view>
