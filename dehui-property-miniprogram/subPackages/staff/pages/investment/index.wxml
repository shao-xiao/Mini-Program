<view class="page">
  <view class="staff-header"><view class="staff-header-title">看房预约</view><view class="staff-header-desc">与管理后台共用 investment_lead，不建立移动端平行数据。</view></view>
  <view class="staff-filter"><view class="staff-filter-item {{status === '' ? 'active' : ''}}" data-status="" bindtap="filter">全部</view><view class="staff-filter-item {{status === 'NEW' ? 'active' : ''}}" data-status="NEW" bindtap="filter">新线索</view><view class="staff-filter-item {{status === 'FOLLOWING' ? 'active' : ''}}" data-status="FOLLOWING" bindtap="filter">跟进中</view><view class="staff-filter-item {{status === 'VIEWED' ? 'active' : ''}}" data-status="VIEWED" bindtap="filter">已看房</view></view>
  <view wx:if="{{error}}" class="staff-empty">{{error}}</view>
  <view wx:for="{{records}}" wx:key="id" class="staff-record" data-id="{{item.id}}" bindtap="detail"><view class="staff-row"><view class="staff-record-title">{{item.applicantName}} · {{item.verifiedPhone}}</view><view class="staff-status">{{item.status}}</view></view><view class="staff-record-meta">{{item.companyName || '未填写公司'}} · {{item.listingTitleSnapshot || item.roomCodeSnapshot}}</view><view class="staff-record-meta">预约 {{item.preferredVisitTime}} · 提交 {{item.createdAt}}</view></view>
  <view wx:if="{{loading}}" class="staff-empty">正在加载…</view><view wx:if="{{!loading && !records.length}}" class="staff-empty">暂无小程序看房预约</view><view wx:if="{{!hasMore && records.length}}" class="more">没有更多了</view>
</view>
