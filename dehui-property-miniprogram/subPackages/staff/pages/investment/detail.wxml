<view class="page">
  <view wx:if="{{error}}" class="staff-empty">{{error}}</view>
  <view wx:if="{{detail}}" class="staff-record"><view class="staff-row"><view class="staff-record-title">{{detail.applicantName}} · {{detail.verifiedPhone}}</view><view class="staff-status">{{detail.status}}</view></view><view class="staff-record-meta">公司：{{detail.companyName || '未填写'}}｜预约：{{detail.preferredVisitTime}}</view><view class="staff-record-meta">房源：{{detail.listingTitleSnapshot || detail.roomCodeSnapshot}}｜{{detail.buildingNameSnapshot}} {{detail.floorSnapshot}}</view><view class="staff-actions" wx:if="{{canFollow}}"><button class="staff-button secondary" data-status="FOLLOWING" bindtap="status">跟进中</button><button class="staff-button secondary" data-status="VIEWING_SCHEDULED" bindtap="status">已约看房</button><button class="staff-button secondary" data-status="VIEWED" bindtap="status">已看房</button><button class="staff-button secondary" data-status="INVALID" bindtap="status">无效</button><button wx:if="{{canConvert}}" class="staff-button" data-status="CONVERTED" bindtap="status">已转化</button></view></view>
  <view wx:if="{{canFollow}}" class="staff-form"><view class="staff-label">新增跟进记录</view><textarea class="staff-textarea" value="{{content}}" bindinput="input" /><button class="staff-button" bindtap="follow" disabled="{{submitting || !content}}">保存跟进</button></view>
  <view wx:if="{{detail && detail.followRecords.length}}" class="staff-record"><view class="staff-record-title">跟进历史</view><view wx:for="{{detail.followRecords}}" wx:key="createdAt" class="staff-record-meta">{{item.createdAt}} · {{item.operatorName}} · {{item.followType}}｜{{item.content}}</view></view>
</view>
