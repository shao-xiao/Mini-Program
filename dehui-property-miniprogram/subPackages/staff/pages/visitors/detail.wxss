page {
  --dhic-page-action-primary: var(--dhic-success);
  --dhic-page-action-soft: var(--dhic-success-soft);
  --dhic-page-action-rgb: var(--dhic-success-rgb);
}

.visitor-status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: var(--dhic-tech-700);
  color: var(--dhic-text-inverse);
}

.visitor-status-label {
  color: rgba(var(--dhic-white-rgb), 0.72);
  font-size: 22rpx;
}

.visitor-status-value {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: var(--dhic-weight-data);
}

.visitor-code {
  max-width: 350rpx;
  color: rgba(var(--dhic-white-rgb), 0.78);
  font-size: 22rpx;
  text-align: right;
  word-break: break-all;
}

.visitor-phone {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--dhic-border-light);
}

.review-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 170rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--dhic-border);
  border-radius: 12rpx;
  background: var(--dhic-surface-raised);
  color: var(--dhic-text-primary);
  font-size: 28rpx;
}

.review-count {
  margin-top: 8rpx;
  color: var(--dhic-text-tertiary);
  font-size: 22rpx;
  text-align: right;
}

.review-actions,
.qr-actions {
  justify-content: flex-end;
}

.review-actions .staff-button,
.qr-actions .staff-button {
  flex: 1;
}

.reject-button {
  border: 1rpx solid var(--dhic-danger);
  background: var(--dhic-surface) !important;
  color: var(--dhic-danger) !important;
}

.audit-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--dhic-border-light);
  color: var(--dhic-text-secondary);
  font-size: 26rpx;
}

.audit-row:last-child {
  border-bottom: 0;
}

.audit-row text:last-child {
  flex: 1;
  color: var(--dhic-text-primary);
  text-align: right;
}

.qr-time {
  max-width: 260rpx;
  color: var(--dhic-text-tertiary);
  font-size: 22rpx;
  text-align: right;
}

.qr-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx dashed var(--dhic-border-strong);
  border-radius: 14rpx;
  color: var(--dhic-text-secondary);
  font-size: 24rpx;
}

.qr-preview image {
  width: 280rpx;
  height: 280rpx;
  margin-bottom: 12rpx;
  background: var(--dhic-surface);
}

.qr-placeholder {
  margin-bottom: 12rpx;
  padding: 50rpx 36rpx;
  border-radius: 12rpx;
  background: var(--dhic-surface-muted);
  color: var(--dhic-text-secondary);
}

.single-action .staff-button {
  width: 100%;
}
