<view class="page visitor-list-page">
  <view class="staff-header">
    <view class="staff-header-title">访客预约管理</view>
    <view class="staff-header-desc">审核、二维码与到访核验均由服务端统一记录。</view>
  </view>

  <scroll-view class="visitor-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="staff-filter">
      <view class="staff-filter-item {{status === '' ? 'active' : ''}}" data-status="" bindtap="filter">全部</view>
      <view class="staff-filter-item {{status === 'PENDING' ? 'active' : ''}}" data-status="PENDING" bindtap="filter">待审核</view>
      <view class="staff-filter-item {{status === 'REGISTERED' ? 'active' : ''}}" data-status="REGISTERED" bindtap="filter">待核验</view>
      <view class="staff-filter-item {{status === 'ENTERED' ? 'active' : ''}}" data-status="ENTERED" bindtap="filter">已到访</view>
      <view class="staff-filter-item {{status === 'LEFT' ? 'active' : ''}}" data-status="LEFT" bindtap="filter">已离场</view>
      <view class="staff-filter-item {{status === 'REJECTED' ? 'active' : ''}}" data-status="REJECTED" bindtap="filter">已驳回</view>
    </view>
  </scroll-view>

  <view wx:if="{{error}}" class="staff-empty">{{error}}</view>
  <view
    wx:for="{{records}}"
    wx:key="id"
    class="staff-record visitor-record"
    data-id="{{item.id}}"
    bindtap="detail"
  >
    <view class="staff-row">
      <view class="staff-record-title visitor-record-title">{{item.visitorName}} · {{item.maskedPhone}}</view>
      <view class="staff-status status-{{item.statusTone}}">{{item.statusText}}</view>
    </view>
    <view class="staff-record-meta">{{item.tenantName || '未关联租户'}} · {{item.applicantName || '未知申请人'}}</view>
    <view class="staff-record-meta">{{item.visitTime || '时间待确认'}}</view>
    <view class="staff-record-meta">{{item.visitCompany || '来访单位未填写'}} · {{item.visitReason || '来访事由未填写'}}</view>
  </view>

  <view wx:if="{{loading}}" class="staff-empty">正在加载…</view>
  <view wx:if="{{!loading && !records.length}}" class="staff-empty">暂无访客预约</view>
  <view wx:if="{{!hasMore && records.length}}" class="more">没有更多了</view>
</view>
