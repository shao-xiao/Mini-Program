page {
  --dhic-page-action-primary: var(--dhic-success);
  --dhic-page-action-soft: var(--dhic-success-soft);
  --dhic-page-action-rgb: var(--dhic-success-rgb);
}

.visitor-filter-scroll {
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.visitor-filter-scroll .staff-filter {
  width: max-content;
  margin-bottom: 0;
}

.visitor-record {
  border: 1rpx solid var(--dhic-border-light);
  box-shadow: 0 6rpx 18rpx rgba(var(--dhic-accent-rgb), 0.04);
}

.visitor-record-title {
  min-width: 0;
  padding-right: 16rpx;
}

.staff-status.status-pending {
  background: var(--dhic-orange-soft);
  color: var(--dhic-orange);
}

.staff-status.status-ready {
  background: var(--dhic-info-soft);
  color: var(--dhic-info);
}

.staff-status.status-entered {
  background: var(--dhic-success-soft);
  color: var(--dhic-success);
}

.staff-status.status-left,
.staff-status.status-cancelled,
.staff-status.status-expired {
  background: var(--dhic-neutral-soft);
  color: var(--dhic-text-secondary);
}

.staff-status.status-rejected {
  background: var(--dhic-danger-soft);
  color: var(--dhic-danger);
}
